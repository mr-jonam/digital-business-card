NODE_ENV=development
HOST=127.0.0.1
PORT=3600
PUBLIC_ORIGIN=http://127.0.0.1:3600
# A separate database, never the lead magnet database.
DATABASE_URL=mysql://cards_user:CHANGE_ME@127.0.0.1:3306/digital_cards
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
STORAGE_DIR=./storage
# Optional external JSON with name, logo and mark file paths. Never inside public/.
BRAND_FILE=
# Configure the actual controller and complete privacy text before opening forms.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
PRIVACY_NOTICE=
RETENTION_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
