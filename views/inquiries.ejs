<%- include('partials/head') %>
<h1>Received requests</h1><p>The latest 200 requests for profiles you can access. Configured retention: <%= config.privacy.retention %> days. No automatic email is sent to the visitor.</p>
<% if (!config.smtp) { %><p class="notice warning">SMTP is not configured. Contact details are saved here; notifications remain pending.</p><% } %>
<div class="stack"><% inquiries.forEach(item => { %><article class="panel">
<p class="eyebrow"><%= item.kind === 'message' ? 'MESSAGE' : 'CALLBACK' %></p><h2><%= item.draft.first_name %> <%= item.draft.last_name %></h2><p><time datetime="<%= item.created_at.toISOString() %>"><%= item.created_at.toLocaleString('en-GB', {timeZone:'Europe/Rome'}) %></time></p>
<dl><% if(item.name) { %><dt>Name</dt><dd><%= item.name %></dd><% } %><% if(item.email) { %><dt>Email</dt><dd class="break"><%= item.email %></dd><% } %><% if(item.phone) { %><dt>Phone</dt><dd><%= item.phone %></dd><% } %></dl><% if(item.message) { %><p class="message-text"><%= item.message %></p><% } %>
<p>Notification: <strong><%= {pending:'Pending',sending:'Sending',sent:'Sent',failed:'Failed'}[item.status] || 'Unavailable' %></strong><% if (item.last_error) { %> · <%= item.last_error %><% } %></p>
<div class="actions"><% if (['pending','failed'].includes(item.status)) { %><form action="/admin/inquiries/<%= item.id %>/retry" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary small" type="submit">Retry notification</button></form><% } %><form action="/admin/inquiries/<%= item.id %>/delete" method="post" data-confirm="Permanently delete this request?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button danger small" type="submit">Delete request</button></form></div>
</article><% }) %></div>
<% if(!inquiries.length) { %><p class="panel">No requests received yet.</p><% } %>
<%- include('partials/foot') %>
