<%- include('partials/head') %>
<h1>Account security</h1>
<% if (secret) { %>
<section class="panel narrow"><h2>Enable two-step verification</h2><p>Scan the code with Microsoft Authenticator, Google Authenticator or a compatible app. Keep access to your VM so you can recover your account if you lose your phone.</p>
<img class="qr" src="/admin/security/qr.png" alt="QR code to set up your authenticator app" width="280" height="280">
<details><summary>Manual setup</summary><p>Secret key: <code class="break"><%= secret %></code></p><p>TOTP · 6 digits · every 30 seconds</p></details>
<form method="post" action="/admin/security/totp" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Authenticator code<input name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required></label><button class="button" type="submit">Enable and continue</button></form></section>
<% } else { %><p class="notice">Two-step verification is enabled.</p><% } %>
<% if (!secret || user.role === 'editor') { %>
<section class="panel narrow"><h2>Change password</h2><form method="post" action="/admin/security/password" class="stack">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<label>Current password<input name="current_password" type="password" autocomplete="current-password" required></label>
<label>New password<input name="new_password" type="password" autocomplete="new-password" minlength="14" maxlength="72" required></label>
<label>Confirm new password<input name="confirm_password" type="password" autocomplete="new-password" minlength="14" maxlength="72" required></label>
<p class="hint">At least 14 characters, maximum 72 bytes. Changing your password signs out all sessions.</p><button class="button" type="submit">Update password</button></form></section>
<% } %>
<%- include('partials/foot') %>
