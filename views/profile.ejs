<%- include('partials/head') %>
<p><a href="/admin">← Biglietti</a></p><h1><%= title %></h1>
<% if (row) { %>
<section class="panel"><p>Stato: <strong><%= {draft:'Bozza',published:'Pubblicato',suspended:'Sospeso'}[row.status] %></strong> · Revisione pubblica <%= row.revision %></p>
<div class="actions"><a class="button secondary" href="/admin/profiles/<%= row.id %>/preview">Anteprima bozza</a>
<form method="post" action="/admin/profiles/<%= row.id %>/publish"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= row.version %>"><button type="submit" class="button">Pubblica la bozza salvata</button></form>
<% if (row.status === 'published') { %><a class="button secondary" href="/admin/profiles/<%= row.id %>/share">QR e condivisione</a><a class="button secondary" href="/c/<%= row.public_id %>">Apri biglietto pubblico</a>
<% if (user.role === 'admin') { %><form method="post" action="/admin/profiles/<%= row.id %>/suspend" data-confirm="Sospendere la scheda e le sue esportazioni pubbliche?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="button danger">Sospendi</button></form><% } } %></div>
<p class="hint">Salva le modifiche prima di pubblicare. L’URL e il QR della pagina rimangono gli stessi. Le copie del QR contatto conservano i dati del momento.</p></section>
<% } %>
<form method="post" action="<%= row ? '/admin/profiles/'+row.id : '/admin/profiles' %>" class="panel stack" id="profile-form">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= row?.version || 0 %>">
<fieldset><legend>Identità</legend><div class="form-grid">
<label>Nome<input name="first_name" value="<%= profile.first_name || '' %>" maxlength="80" autocomplete="given-name" required></label>
<label>Cognome<input name="last_name" value="<%= profile.last_name || '' %>" maxlength="80" autocomplete="family-name" required></label>
<label class="wide">Titolo professionale<input name="title" value="<%= profile.title || '' %>" maxlength="120" required></label>
<label>Organizzazione<input name="company" value="<%= profile.company || '' %>" maxlength="120"></label>
<label>Telefono pubblico <span>(facoltativo)</span><input name="phone" type="tel" value="<%= profile.phone || '' %>" maxlength="40" aria-describedby="phone-hint"></label>
<p class="hint wide" id="phone-hint">Includi il prefisso internazionale, per esempio +39. Il numero sarà visibile sul biglietto e nel contatto.</p>
<label class="wide">Email riservata per ricevere le notifiche<input name="recipient" type="email" value="<%= profile.recipient || '' %>" maxlength="254" required aria-describedby="recipient-hint"></label>
<p class="hint wide" id="recipient-hint">Non viene inclusa nella pagina pubblica, nella vCard o nel QR. I messaggi vengono inviati dal server.</p>
<% if (user.role === 'admin') { %><label class="wide">Editor assegnato<select name="owner_id"><option value="">Solo amministratori</option><% users.forEach(account => { %><option value="<%= account.id %>" <%= row?.owner_id === account.id ? 'selected' : '' %>><%= account.email %> (<%= account.role %>)</option><% }) %></select></label><% } %>
</div></fieldset>
<fieldset><legend>LinkedIn e siti</legend><p class="hint">Fino a 12 link HTTPS. Titolo e descrizione diventano pulsanti sul biglietto.</p>
<div id="links-list"><% const links = profile.links?.length ? profile.links : [{label:'',url:'',description:'',kind:'site'}]; links.forEach((link, i) => { %><div class="link-row">
<label>Titolo<input name="link_label" value="<%= link.label %>" maxlength="80"></label><label>Descrizione<input name="link_description" value="<%= link.description || '' %>" maxlength="100"></label><label>URL HTTPS<input name="link_url" value="<%= link.url %>" type="url" maxlength="2048"></label><label>Tipo<select name="link_kind"><option value="site">Sito web</option><option value="linkedin" <%= link.kind === 'linkedin' ? 'selected' : '' %>>LinkedIn</option></select></label><button type="button" class="button secondary small" data-remove-link>Rimuovi link</button></div><% }) %></div><button type="button" class="button secondary small" id="add-link">Aggiungi link</button>
</fieldset>
<fieldset><legend>Aspetto del biglietto</legend><div class="form-grid">
<label>Tema<select name="theme"><% [['graphite','Grafite'],['petrol','Petrolio'],['midnight','Mezzanotte'],['forest','Foresta']].forEach(([value,label]) => { %><option value="<%= value %>" <%= profile.appearance?.theme === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
<label>Disegno QA<select name="art"><% [['qa-platforms','Piattaforme digitali'],['qa-flow','Flusso di test'],['coverage','Copertura'],['none','Nessuno']].forEach(([value,label]) => { %><option value="<%= value %>" <%= profile.appearance?.art === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
<label>Finitura<select name="finish"><% [['holo','Olografica'],['spotlight','Riflesso morbido'],['plain','Senza riflessi']].forEach(([value,label]) => { %><option value="<%= value %>" <%= profile.appearance?.finish === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
<label>Sfondo pagina<select name="backdrop"><% [['qa-grid','Griglia QA'],['grid','Griglia semplice'],['plain','Uniforme']].forEach(([value,label]) => { %><option value="<%= value %>" <%= profile.appearance?.backdrop === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
<label>Colore superficie <span>(facoltativo)</span><input name="surface" value="<%= profile.appearance?.surface || '' %>" pattern="#[0-9a-fA-F]{6}" maxlength="7" placeholder="#191e24"></label>
<label>Colore accento <span>(facoltativo)</span><input name="accent" value="<%= profile.appearance?.accent || '' %>" pattern="#[0-9a-fA-F]{6}" maxlength="7" placeholder="#df0030"></label>
<label>Colore QR<select name="qr_ink"><option value="black">Nero su bianco</option><option value="petrol" <%= profile.qr_ink === 'petrol' ? 'selected' : '' %>>Petrolio su bianco</option></select></label>
</div><p class="hint">Il sistema scurisce automaticamente i colori che ridurrebbero la leggibilità. Il QR mantiene contrasto e margine di scansione.</p></fieldset>
<button type="submit" class="button"><%= row ? 'Salva bozza' : 'Crea bozza' %></button></form>
<% if (row) { %>
<section class="panel"><h2>Foto</h2><% if (profile.photo) { %><img class="photo-preview" src="/admin/profiles/<%= row.id %>/photo" alt="Foto attuale nella bozza" width="100" height="120"><% } %><form action="/admin/profiles/<%= row.id %>/photo" method="post" enctype="multipart/form-data" id="photo-form" class="stack" data-csrf="<%= csrf %>"><input type="hidden" name="version" value="<%= row.version %>"><label>Foto PNG, JPEG o WebP<input type="file" name="photo" accept="image/png,image/jpeg,image/webp" required></label><p class="hint">Massimo 2 MB e 16 megapixel. La foto viene ricodificata e i metadati rimossi. Salva prima le altre modifiche.</p><button class="button secondary" type="submit">Carica foto nella bozza</button><p role="status" id="photo-status"></p></form></section>
<% } %>
<%- include('partials/foot') %>
