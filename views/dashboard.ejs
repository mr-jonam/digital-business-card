<%- include('partials/head') %>
<div class="heading"><div><p class="eyebrow">PROFILES AND SHARING</p><h1>Business cards</h1></div><% if (user.role === 'admin') { %><a href="/admin/profiles/new" class="button">Create profile</a><% } %></div>
<% if (!config.formsEnabled) { %><p class="notice warning">Public forms are disabled. Set the data controller, privacy contact and privacy notice in the environment file.</p><% } %>
<% if (!config.smtp) { %><p class="notice warning">SMTP is not configured. Requests are saved; notifications remain pending.</p><% } %>
<div class="card-grid">
<% profiles.forEach(row => { %><article class="panel"><span class="state"><%= {draft:'Draft',published:'Published',suspended:'Suspended'}[row.status] %></span><h2><%= row.draft.first_name %> <%= row.draft.last_name %></h2><p><%= row.draft.title %></p><p class="hint">Draft v<%= row.version %> · Public revision <%= row.revision %></p><div class="actions"><a class="button" href="/admin/profiles/<%= row.id %>">Manage</a><% if (row.status === 'published') { %><a class="button secondary" href="/admin/profiles/<%= row.id %>/share">QR and sharing</a><% } %></div></article><% }) %>
</div>
<% if (!profiles.length) { %><p class="panel">No profiles available. Create your first card or import a profile file.</p><% } %>
<%- include('partials/foot') %>
