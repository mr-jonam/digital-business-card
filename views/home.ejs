<%- include('partials/head') %>
<section class="panel narrow"><h1><%= brand.name %></h1><p>Biglietti da visita digitali</p><div class="stack"><% profiles.forEach(profile => { %><a class="profile-link" href="/c/<%= profile.public_id %>"><strong><%= profile.first_name %> <%= profile.last_name %></strong><span><%= profile.title %></span><span aria-hidden="true">↗</span></a><% }) %></div><% if (!profiles.length) { %><p>Nessun biglietto pubblicato.</p><% } %></section>
<%- include('partials/foot') %>
