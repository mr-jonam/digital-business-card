<% for (const kind of ['callback','message']) { const callback=kind==='callback'; %>
<dialog id="<%= kind %>-dialog" aria-labelledby="<%= kind %>-title">
  <div class="dialog-header"><p class="eyebrow"><%= callback ? 'LET’S STAY IN TOUCH' : 'DIRECT CONTACT' %></p><button type="button" class="close-button" data-close aria-label="Close">×</button></div>
  <h2 id="<%= kind %>-title" tabindex="-1"><%= callback ? 'Leave your details' : 'Send a message' %></h2>
  <p class="dialog-intro">For <%= profile.first_name %> <%= profile.last_name %>. <%= callback ? 'An email address or phone number is all we need.' : 'The recipient’s email address stays private.' %></p>
  <% if (!preview && config.formsEnabled) { %><form method="post" action="/c/<%= publicId %>/inquiries" data-inquiry>
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="submission_id" value="<%= submissionId %>"><input type="hidden" name="kind" value="<%= kind %>">
    <div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
    <div class="field"><label for="<%= kind %>-name">Your name (optional)</label><input id="<%= kind %>-name" name="name" maxlength="100" autocomplete="name"></div>
    <div class="field"><label for="<%= kind %>-email">Your email<%= callback ? ' (or phone)' : '' %></label><input id="<%= kind %>-email" name="email" type="email" maxlength="254" autocomplete="email" inputmode="email" <%= callback ? '' : 'required' %>></div>
    <% if (callback) { %><div class="field"><label for="callback-phone">Your phone number (or email)</label><input id="callback-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" aria-describedby="phone-hint"><p id="phone-hint" class="field-hint">Include the country code, for example +39.</p></div><% } else { %><div class="field"><label for="message-body">Message</label><textarea id="message-body" name="message" required maxlength="3000" rows="4"></textarea></div><% } %>
    <details class="privacy-text"><summary>How we use your data</summary><p>Data controller: <%= config.privacy.controller %>. Privacy contact: <%= config.privacy.contact %>.</p><p><%= config.privacy.notice %></p><p>System retention: <%= config.privacy.retention %> days. You will not be automatically subscribed to a newsletter.</p></details>
    <button type="submit" class="button button-primary"><%= callback ? 'Request a callback' : 'Send message' %></button><p class="form-status" role="status" aria-live="polite"></p>
  </form><% } else { %><p>This form is disabled in this mode.</p><% } %>
</dialog><% } %>
<dialog id="contact-dialog" aria-labelledby="contact-title"><div class="dialog-header"><p class="eyebrow">ON YOUR PHONE</p><button type="button" class="close-button" data-close aria-label="Close">×</button></div><h2 id="contact-title" tabindex="-1">Add contact</h2>
  <div class="contact-summary"><strong><%= profile.first_name %> <%= profile.last_name %></strong><span><%= profile.title %></span></div>
  <p class="platform-note">Your phone may open a contact preview. Some browsers, especially on Android, download a file that you need to open. Confirm saving in your Contacts app.</p>
  <% if (!preview) { %><a class="button button-primary" href="/c/<%= publicId %>/contact.vcf">Open contact on your phone</a><% } %>
  <button type="button" class="button button-light" id="copy-contact">Copy contact details</button>
  <div id="copy-fallback" hidden><label for="contact-data">Selectable contact details</label><textarea id="contact-data" rows="6" readonly><%= [profile.first_name+' '+profile.last_name,profile.title,profile.phone,...profile.links.map(link=>link.label+': '+link.url),cardUrl(publicId)].filter(Boolean).join('\n') %></textarea></div><p class="form-status" id="copy-status" role="status"></p>
  <p class="privacy-text">The private email address is not included. Use the link in the contact to return to this card and send a message.</p>
  <% if (!preview && config.formsEnabled) { %><div class="exchange-contact"><p>Would you like us to get back to you?</p><button type="button" class="button button-primary" data-dialog="callback-dialog">Leave your details</button></div><% } %>
</dialog>
<dialog id="info-dialog" aria-labelledby="info-title"><div class="dialog-header"><p class="eyebrow">INFORMATION</p><button type="button" class="close-button" data-close aria-label="Close">×</button></div><h2 id="info-title" tabindex="-1">Privacy notice</h2><p>Data controller: <%= config.privacy.controller || 'Setup in progress' %>.</p><p><%= config.privacy.notice || 'Contact forms are disabled.' %></p><p>Privacy contact: <%= config.privacy.contact %>. System retention: <%= config.privacy.retention %> days.</p><p>We use an essential cookie for security and to make the forms work. No advertising tracking.</p></dialog>

