<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="color-scheme" content="light">
  <title><%= title %> | Digital Card</title>
  <link rel="stylesheet" href="/assets/admin.css">
  <script src="/assets/admin.js" defer></script>
</head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class="app-header">
  <a class="brand" href="/admin"><%= brand.name %> <span>Digital Card</span></a>
  <% if (typeof user !== 'undefined' && user) { %>
  <nav aria-label="Administration"><a href="/admin">Cards</a><a href="/admin/inquiries">Requests</a><a href="/admin/security">Security</a></nav>
  <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button small secondary" type="submit">Sign out</button></form>
  <% } %>
</header>
<main id="content" class="app-content">
